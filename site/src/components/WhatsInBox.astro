---
const features = [
  {
    title: "Auth, fully wired",
    blurb: "Email/password register & login, Google OAuth, password reset via SMTP, DB-backed sessions, CSRF tokens, rate limiting, account lockout. Working out of the box.",
    icon: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 1-.1 1.3l2 1.6-2 3.4-2.4-1a7.4 7.4 0 0 1-2.2 1.3L14.4 21h-4l-.3-2.4a7.4 7.4 0 0 1-2.2-1.3l-2.4 1-2-3.4 2-1.6a7.4 7.4 0 0 1 0-2.6l-2-1.6 2-3.4 2.4 1a7.4 7.4 0 0 1 2.2-1.3L10.4 3h4l.3 2.4a7.4 7.4 0 0 1 2.2 1.3l2.4-1 2 3.4-2 1.6c.07.4.1.9.1 1.3Z",
    large: true,
  },
  {
    title: "Resumable uploads",
    blurb: "Multipart FormData for avatars, TUS protocol for large files — chunked, resumable, progress tracking.",
    icon: "M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2",
  },
  {
    title: "sqlc, no ORM",
    blurb: "Write SQL in queries/*.sql, get type-safe Go. Compile-time safety, zero runtime reflection.",
    icon: "M4 7h16M4 12h16M4 17h10M9 4v6M15 14v6",
  },
  {
    title: "Migrations on startup",
    blurb: "Goose runs automatically when the binary starts. One table per file, never edit a deployed migration.",
    icon: "M12 6v12m-3-2.828L7.172 14 5 16.172 9 20l4-4M19 8l-4-4-4 4",
  },
  {
    title: "Deploy anywhere",
    blurb: "Multi-stage Dockerfile, CGO cross-compile via Zig, graceful shutdown, security headers.",
    icon: "M12 3l8 4v5c0 5-3.4 8.5-8 11-4.6-2.5-8-6-8-11V7l8-4Zm-3 9 2 2 4-4",
  },
];
---

<section class="lj-box">
  <h2 class="lj-section-title">What's <span class="lj-accent">in the box</span></h2>
  <p class="lj-section-sub">Not a TODO list. Working code, wired end to end.</p>

  <div class="lj-box-grid">
    {features.map((f) => (
      <div class={`lj-box-card${f.large ? " lj-box-large" : ""}`}>
        <div class="lj-box-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={f.icon} />
          </svg>
        </div>
        <h3>{f.title}</h3>
        <p>{f.blurb}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .lj-box {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .lj-box-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .lj-box-large {
    grid-column: span 2;
  }

  @media (max-width: 880px) {
    .lj-box-grid {
      grid-template-columns: 1fr;
    }
    .lj-box-large {
      grid-column: span 1;
    }
  }


  .lj-box-card {
    border: 1px solid #1e293b;
    border-radius: 0.6rem;
    padding: 1.4rem;
    background: #0b111f;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .lj-box-card:hover {
    border-color: #22d3ee;
    transform: translateY(-2px);
  }

  .lj-box-large h3 {
    font-size: 1.2rem;
  }

  .lj-box-large p {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .lj-box-icon {
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 0.4rem;
    background: rgba(34, 211, 238, 0.1);
    color: #22d3ee;
    margin-bottom: 0.75rem;
  }

  .lj-box-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .lj-box-card p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: #64748b;
  }
</style>
