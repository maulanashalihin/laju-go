---
const stats = [
  { value: "1", label: "binary, full stack" },
  { value: "3", label: "tiers, strict separation" },
  { value: "0", label: "ORMs required" },
  { value: "11x", label: "faster than Node" },
];
---

<div class="lj-stats">
  {stats.map((s) => (
    <div class="lj-stat">
      <span class="lj-stat-value">{s.value}</span>
      <span class="lj-stat-label">{s.label}</span>
    </div>
  ))}
</div>

<style>
  .lj-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1px;
    background: #1e293b;
    border: 1px solid #1e293b;
    border-radius: 0.6rem;
    overflow: hidden;
    max-width: 800px;
    margin: 3rem auto 4rem;
  }
  .lj-stat {
    background: #070b16;
    padding: 1.4rem 1rem;
    text-align: center;
  }
  .lj-stat-value {
    display: block;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #22d3ee;
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }
  .lj-stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    color: #64748b;
  }
</style>
