---
const reasons = [
  {
    title: "Go means one binary",
    blurb: "No runtime to install on the server. No node_modules in production. No JIT warmup. You scp one file and run it. Fiber on fasthttp is one of the fastest Go web frameworks available — headroom you'll never worry about.",
    icon: "M13 3L4 14h7l-1 7 9-11h-7l1-7z",
    large: true,
  },
  {
    title: "SQLite, zero ops",
    blurb: "One file to back up — copy it, done. No database server to run, no connection pool to tune. WAL mode serves tens of thousands of reads per second.",
    icon: "M4 7h16M4 12h16M4 17h10M9 4v6M15 14v6",
  },
  {
    title: "sqlc, no ORM tax",
    blurb: "Write SQL, get type-safe Go. Compile-time safety, zero runtime reflection. The SQL is the source of truth — grep queries/ and you have the complete data access surface.",
    icon: "M4 7h16M4 12h16M4 17h10M9 4v6M15 14v6",
  },
];
---

<section class="lj-why">
  <h2 class="lj-section-title">Why <span class="lj-accent">this stack</span></h2>
  <p class="lj-section-sub">Every choice eliminates a category of complexity. Not adds a feature — removes one.</p>
  <div class="lj-why-grid">
    {reasons.map((r) => (
      <div class={`lj-why-card${r.large ? " lj-why-large" : ""}`}>
        <div class="lj-why-head">
          <span class="lj-why-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={r.icon} />
            </svg>
          </span>
          <h3>{r.title}</h3>
        </div>
        <p>{r.blurb}</p>
      </div>
    ))}
  </div>
  <p class="lj-why-link">For the full reasoning, read the <a href="/philosophy/">philosophy page</a>.</p>
</section>

<style>
  .lj-why { max-width: 960px; margin: 0 auto 4.5rem; padding: 0 1.5rem; }
  .lj-why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .lj-why-large {
    grid-column: span 2;
  }
  @media (max-width: 640px) {
    .lj-why-grid {
      grid-template-columns: 1fr;
    }
    .lj-why-large {
      grid-column: span 1;
    }
  }
  .lj-why-card {
    border: 1px solid #1e293b;
    border-radius: 0.6rem;
    padding: 1.4rem;
    background: #0b111f;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .lj-why-card:hover {
    border-color: #22d3ee;
    transform: translateY(-2px);
  }
  .lj-why-large h3 { font-size: 1.15rem; }
  .lj-why-large p { font-size: 0.92rem; line-height: 1.65; }
  .lj-why-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .lj-why-head h3 { margin: 0; font-size: 1.05rem; }
  .lj-why-icon {
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 0.4rem;
    background: rgba(34, 211, 238, 0.1);
    color: #22d3ee;
    flex-shrink: 0;
  }
  .lj-why-card p { margin: 0; font-size: 0.88rem; line-height: 1.55; color: #64748b; }
  .lj-why-link {
    text-align: center;
    margin: 2rem 0 0;
    color: #475569;
    font-size: 0.9rem;
  }
  .lj-why-link a {
    color: #22d3ee;
    text-decoration: none;
  }
  .lj-why-link a:hover {
    text-decoration: underline;
  }
</style>
