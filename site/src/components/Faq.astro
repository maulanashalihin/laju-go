---
const faqs: { q: string; a: string }[] = [
    {
        q: "Is it free?",
        a: "Yes. MIT licensed. No account, no payment, no telemetry. Fork it, own it, ship it.",
    },
    {
        q: "What's included?",
        a: "Auth (register, login, Google OAuth, password reset, sessions, CSRF, rate limiting), uploads (avatar multipart + TUS large files), SQLite with sqlc type-safe queries, Goose migrations, three-tier architecture, tests, multi-stage Dockerfile, and your choice of Svelte 5, React 19, or Vue 3 — all with TailwindCSS.",
    },
    {
        q: "Do I have to use Svelte?",
        a: "No. Run `npx create-laju-go@latest my-app` and pick Svelte, React, or Vue. Or use `--template react` / `--template vue`. The Go backend stays identical regardless of your frontend choice.",
    },
    {
        q: "Can I deploy with Docker?",
        a: "Yes. Multi-stage Dockerfile included, plus a `make build-linux` target that cross-compiles via Zig for CGO/SQLite. Deploy to any VPS, Fly.io, Railway, or anywhere that runs a binary or container.",
    },
    {
        q: "Why SQLite and not Postgres?",
        a: "One file, zero ops, WAL mode tuned for concurrency. Enough for most SaaS apps. When you outgrow it, swap the sqlc engine and connection string — the query layer stays the same.",
    },
    {
        q: "Why no ORM?",
        a: "sqlc generates type-safe Go from plain SQL. Compile-time safety, zero runtime reflection. You see the exact SQL that runs, at peak performance. No N+1 surprises, no hidden query generation.",
    },
];
---

<section class="lj-faq">
    <div class="lj-faq-cta">
        <h2 class="lj-section-title">Start in one command.</h2>
        <div class="lj-cta-cmd">npx create-laju-go@latest my-app</div>
        <div class="lj-cta-actions">
            <a class="lj-btn lj-btn-primary" href="/getting-started/introduction/">Read the docs</a>
            <a class="lj-btn lj-btn-ghost" href="https://github.com/maulanashalihin/laju-go" target="_blank" rel="noreferrer">Star on GitHub</a>
        </div>
    </div>
    <h2 class="lj-section-title">FAQ</h2>
    <p class="lj-section-sub">
        Questions you might have before running `npx create-laju-go@latest`.
    </p>
    <div class="lj-faq-list">
        {faqs.map((f) => (
            <details class="lj-faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
            </details>
        ))}
    </div>
</section>

<style>
    .lj-faq { max-width: 800px; margin: 0 auto 4rem; padding: 0 1.5rem; }

    .lj-faq-cta {
        text-align: center;
        margin-bottom: 4rem;
        padding: 2.5rem 1.5rem;
        border: 1px solid rgba(34, 211, 238, 0.15);
        border-radius: 0.8rem;
        background: rgba(34, 211, 238, 0.03);
    }

    .lj-cta-cmd {
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 1rem;
        color: #22d3ee;
        background: #050810;
        border: 1px solid #1e293b;
        border-radius: 0.5rem;
        padding: 0.8rem 1.2rem;
        display: inline-block;
        margin: 1.25rem 0;
    }

    .lj-cta-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
    }

    .lj-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1.4rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    .lj-btn:hover { transform: translateY(-1px); }

    .lj-btn-primary {
        background: #22d3ee;
        color: #070b16;
        box-shadow: 0 8px 24px rgba(34, 211, 238, 0.25);
    }

    .lj-btn-primary:hover {
        background: #67e8f9;
        box-shadow: 0 8px 32px rgba(34, 211, 238, 0.35);
    }

    .lj-btn-ghost {
        border: 1px solid #1e293b;
        color: #e2e8f0;
        background: rgba(15, 23, 42, 0.4);
    }

    .lj-btn-ghost:hover { border-color: #334155; }

    .lj-faq-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .lj-faq-item {
        border: 1px solid #1e293b;
        border-radius: 0.5rem;
        background: #0b111f;
        overflow: hidden;
        transition: border-color 0.2s ease;
    }

    .lj-faq-item[open] { border-color: #334155; }

    .lj-faq-item summary {
        padding: 1rem 1.25rem;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        list-style: none;
        color: #e2e8f0;
    }

    .lj-faq-item summary::-webkit-details-marker { display: none; }
    .lj-faq-item summary::marker { display: none; }

    .lj-faq-item summary::after {
        content: "+";
        float: right;
        color: #475569;
        font-weight: 400;
        font-size: 1.2rem;
        transition: transform 0.2s ease;
    }

    .lj-faq-item[open] summary::after {
        transform: rotate(45deg);
    }

    .lj-faq-item p {
        margin: 0;
        padding: 0 1.25rem 1.25rem;
        font-size: 0.9rem;
        line-height: 1.65;
        color: #64748b;
    }
</style>
