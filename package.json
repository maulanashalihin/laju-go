{
  "name": "laju-go",
  "version": "1.0.0",
  "description": "Laju Go - High-performance SaaS boilerplate built with Go Fiber, Vue 3, and Inertia.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:go": "air",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:go\"",
    "build": "vite build",
    "build:all": "vite build && go build -o laju-go ./cmd/laju-go",
    "build:go": "go build -o laju-go ./cmd/laju-go",
    "build:linux": "cross-env GOOS=linux GOARCH=amd64 go build -o laju-go ./cmd/laju-go",
    "serve": "go run ./cmd/laju-go",
    "db:refresh": "rimraf ./data/app.db ./data/app.db-shm ./data/app.db-wal ./data/cache",
    "db:migrate": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 ./data/app.db up",
    "db:migrate:status": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 ./data/app.db status",
    "db:migrate:down": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 ./data/app.db down",
    "db:migrate:create": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 create",
    "db:generate": "sqlc generate",
    "verify": "templ generate && vite build && go build -o /dev/null ./cmd/laju-go && go vet ./... && go test ./..."
  },
  "author": "Maulana Shalihin",
  "license": "MIT",
  "dependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "axios": "^1.13.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "lucide-vue-next": "^1.0.1",
    "tus-js-client": "^4.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@inertiajs/vite": "^3.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vue-tsc": "^2.2.0"
  }
}
