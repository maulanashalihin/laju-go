# Go
# Note: go.sum MUST be committed for applications (reproducible builds,
# required by Dockerfile's `COPY go.mod go.sum ./`). Do NOT gitignore it.
vendor/

# Environment
.env

# Database
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# User uploads
storage/*
!storage/.gitkeep


