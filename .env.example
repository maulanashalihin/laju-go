# Laju Go — Environment Configuration
# Copy this file to .env and customize before running.

# Server
APP_PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080

# Database (SQLite)
DB_PATH=./data/app.db

# Session
SESSION_SECRET=change-this-in-production
SESSION_TTL=24h

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Email (optional — MAIL_DRIVER=log by default, prints to console)
#   log      → print to console (dev / tests)
#   resend   → https://resend.com (set RESEND_API_KEY)
#   mailtrap → https://mailtrap.io (set MAILTRAP_API_TOKEN, optional MAILTRAP_INBOX_ID for sandbox)
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Laju
RESEND_API_KEY=
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
